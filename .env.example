# =========================
# Application
# =========================
NODE_ENV=development
PORT=8080
APP_PREFIX=/api

# =========================
# Pagination
# =========================
DEFAULT_PAGE=1
DEFAULT_LIMIT=10
MAX_LIMIT=100
MAX_SORT_FIELDS=3

# =========================
# CORS
# =========================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# =========================
# Rate Limit
# =========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
# =========================
# Database
# =========================
DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp

DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=60000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

DATABASE_LOG_QUERY=false

# =========================
# JWT
# =========================
JWT_SECRET=super-secret-key-with-at-least-32-characters
JWT_ISSUER=my-api

# Optional
JWT_AUDIENCE=my-web-app

# Supported:
# 15m, 30m, 1h, 24h, 7d, 30d, 1y
JWT_EXPIRES_IN=15m

# =========================
# Password Hashing
# =========================
BCRYPT_SALT_ROUNDS=10

