{
  "compilerOptions": {
    /* =========================
       Environment
    ========================= */
    "target": "ES2022",
    "lib": ["ES2022"],

    /* =========================
       Modules
    ========================= */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,

    /* =========================
       Project Structure
    ========================= */
    "rootDir": "./",
    "outDir": "./dist",

    /* =========================
       Node & Express
    ========================= */
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true,

    /* =========================
       Strict Type Safety
    ========================= */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    /* =========================
       DX & Performance
    ========================= */
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* =========================
       Path Alias
    ========================= */
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },

    "ignoreDeprecations": "6.0",
  },
  "include": [
    "src/**/*",
    "test",
    "prisma.config.ts",
    "prisma/seeds/*",
    "prisma/seed.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
